cabal-version:      2.4
name:               dotprod-accelerate
version:            0.1.0.0
build-type:         Simple
synopsis:           Accelerate map+reduce dot product, equivalent to a CUDA baseline

executable dotprod-accelerate
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts

    build-depends:    base       >=4.14 && <5
                    , accelerate
                    , accelerate-llvm-ptx
                    , random
                    , deepseq
                    , time

executable dotprod-accelerate-warmup
    main-is:          MainWarmup.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts

    build-depends:    base       >=4.14 && <5
                    , accelerate
                    , accelerate-llvm-ptx
                    , random
                    , deepseq
                    , time
